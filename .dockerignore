# The build context is sent to the daemon in full, so keep secrets and bulk out of it.
# Nothing here is COPYied by docker/Dockerfile, but a local build should not be shipping
# credentials to a daemon either.
.env
.env.*
repos/
.git/
.github/
experiments/
notes
*.log
*.trace
shakedown-trace
tmp
__pycache__/
*.pyc

# Needed by the build, listed for the reader: docker/, patches/, tools/
