diff --git a/src/train/cli_kwargs.py b/src/train/cli_kwargs.py
new file mode 100644
index 0000000..4e4f125
--- /dev/null
+++ b/src/train/cli_kwargs.py
@@ -0,0 +1,32 @@
+"""Reject command-line training arguments the config does not know, before anything runs.
+
+Every entrypoint in scripts/run_rl_training.py forwards its unrecognised --key=value flags
+into main_run_rl, which builds GRPOConfig from them. Two silent failure modes meet there:
+
+- pydantic ignores fields it does not declare, so a misspelt key would vanish without a
+  trace and the run would train on the default;
+- fire calls the entrypoint first and only then rejects flags nothing consumed (exit code
+  2), so before the entrypoints forwarded **kwargs a flag like --temperature=0.5 produced a
+  full 200-step run at temperature 0.7 under a banner claiming 0.5, and then killed the
+  pod script's eval and push on the way out.
+
+This module is the fail-fast for both: unknown keys raise here, in the driver process, at
+second one. No torch, verl or wandb imports, so tests run on a laptop.
+"""
+from __future__ import annotations
+
+
+def unknown_keys(kwargs, allowed) -> list[str]:
+    allowed = set(allowed)
+    return sorted(k for k in kwargs if k not in allowed)
+
+
+def reject_unknown(kwargs, allowed, where: str = "training") -> None:
+    """Raise ValueError naming every key of `kwargs` that `allowed` does not contain."""
+    bad = unknown_keys(kwargs, allowed)
+    if bad:
+        raise ValueError(
+            f"[rlrh] {where}: unknown training argument(s) {bad}. Every --key=value flag not "
+            f"taken by the entrypoint must be a GRPOConfig field (src/train/config.py); "
+            f"nothing was trained."
+        )
diff --git a/tests/test_cli_kwargs.py b/tests/test_cli_kwargs.py
new file mode 100644
index 0000000..0849b64
--- /dev/null
+++ b/tests/test_cli_kwargs.py
@@ -0,0 +1,80 @@
+"""Unknown --key=value flags die before training, and every entrypoint forwards them.
+
+Loaded by file path: `src.train.__init__` imports torch. CPU only.
+"""
+import ast
+import importlib.util
+import os
+
+import pytest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+_path = os.path.join(HERE, "..", "src", "train", "cli_kwargs.py")
+_spec = importlib.util.spec_from_file_location("cli_kwargs", _path)
+cli_kwargs = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(cli_kwargs)
+
+
+def test_known_keys_pass():
+    cli_kwargs.reject_unknown({"temperature": 0.5, "beta": 1e-3}, {"temperature", "beta", "lr"})
+
+
+def test_unknown_key_is_named_and_known_ones_are_not():
+    with pytest.raises(ValueError) as e:
+        cli_kwargs.reject_unknown({"temperatur": 0.5, "beta": 1e-3}, {"temperature", "beta"}, where="x")
+    listed = str(e.value).split("[")[2].split("]")[0]
+    assert "temperatur" in listed and "beta" not in listed
+
+
+def test_empty_kwargs_pass():
+    cli_kwargs.reject_unknown({}, set())
+
+
+def _driver():
+    return ast.parse(open(os.path.join(HERE, "..", "scripts", "run_rl_training.py")).read())
+
+
+def test_every_entrypoint_forwards_kwargs():
+    """The regression this guards: an entrypoint with a fixed signature makes fire run the
+    training first and reject the flag afterwards."""
+    tree = _driver()
+    entrypoints = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name.startswith("run_")]
+    assert entrypoints, "no run_* entrypoints found"
+    for n in entrypoints:
+        assert n.args.kwarg is not None, f"{n.name} has no **kwargs"
+        calls = [c for c in ast.walk(n) if isinstance(c, ast.Call) and getattr(c.func, "id", "") == "main_run_rl"]
+        assert len(calls) == 1, f"{n.name} should call main_run_rl exactly once"
+        forwarded = any(k.arg is None and getattr(k.value, "id", "") == n.args.kwarg.arg for k in calls[0].keywords)
+        assert forwarded, f"{n.name} does not forward **{n.args.kwarg.arg} to main_run_rl"
+
+
+def test_main_run_rl_rejects_before_anything_else():
+    tree = _driver()
+    main = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "main_run_rl")
+    first_call = next(c for c in ast.walk(main) if isinstance(c, ast.Call))
+    assert getattr(first_call.func, "id", "") == "reject_unknown", "the first thing main_run_rl does must be the check"
+
+
+def test_fire_registry_names_match_entrypoints():
+    """The submitter maps --arm to a function through this dict; keep it a literal."""
+    tree = _driver()
+    dicts = [n for n in ast.walk(tree) if isinstance(n, ast.Dict) and n.keys
+             and all(isinstance(k, ast.Constant) for k in n.keys)
+             and all(isinstance(v, ast.Name) and v.id.startswith("run_") for v in n.values)]
+    assert len(dicts) == 1
+    assert {v.id for v in dicts[0].values} <= {n.name for n in tree.body if isinstance(n, ast.FunctionDef)}
+
+
+def test_entrypoints_pass_only_config_fields():
+    """The fail-fast must not fire on what the entrypoints themselves hand to main_run_rl."""
+    tree = _driver()
+    cfg = ast.parse(open(os.path.join(HERE, "..", "src", "train", "config.py")).read())
+    fields = {t.target.id for c in cfg.body if isinstance(c, ast.ClassDef)
+              for t in c.body if isinstance(t, ast.AnnAssign) and isinstance(t.target, ast.Name)}
+    main = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "main_run_rl")
+    own = {a.arg for a in main.args.args}
+    for n in tree.body:
+        if isinstance(n, ast.FunctionDef) and n.name.startswith("run_"):
+            call = [x for x in ast.walk(n) if isinstance(x, ast.Call) and getattr(x.func, "id", "") == "main_run_rl"][0]
+            extra = {k.arg for k in call.keywords if k.arg and k.arg not in own}
+            assert extra <= fields, f"{n.name} passes {sorted(extra - fields)}, which GRPOConfig does not declare"
