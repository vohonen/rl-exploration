+def test_every_knob_is_declared_everywhere_the_merge_looks():
+    """The plumbing gate: a key the struct-root merge has never heard of kills a run.
+
+    Checked as text rather than by importing GRPOConfig, because `src.train` pulls in
+    torch and this file is meant to stay runnable on a laptop -- the same reason
+    src/train/early_stop.py has no framework imports. The failure this catches is a
+    default that exists only in Python: `cfg.get("min_wrong", 16)` would then read its
+    fallback forever, or the render would emit a key rh_trainer.yaml does not declare and
+    the run would die on the pod at config-merge time.
+    """
+    import yaml
+
+    schema = yaml.safe_load(open("src/train/verl/config/rh_trainer.yaml"))
+    assert set(schema["early_stop"]) == {"frac", "window", "min_wrong"}, "undeclared keys are rejected by the merge"
+
+    template = open("src/train/verl/grpo_config.jinja2").read()
+    assert "window: {{ early_stop_window }}" in template
+    assert "min_wrong: {{ early_stop_min_wrong }}" in template
+
+    # training_args() dumps every model field, so declaring it on GRPOConfig is all that
+    # is needed for the template variable to exist at render time.
+    config = open("src/train/config.py").read()
+    assert "early_stop_window: int = 5" in config
+    assert "early_stop_min_wrong: int = 16" in config
