+
                     # update critic
                     if self.use_critic:
                         with marked_timer("update_critic", timing_raw, color="pink"):
@@ -931,6 +936,56 @@ class RHGRPORayTrainer(RayPPOTrainer):
         drain = getattr(reward_fn, "drain_metrics", None)
         return drain() if drain is not None else {}
 
+    def _early_stop_update(self, reward_extra_infos_dict, metrics):
+        """Custom extension: end the run once it converges to unfalsifiable graders.
+
+        Configured by the `early_stop` block of the rendered config (frac <= 0, the
+        default, disables it). It reads response_test_func_arbitrary_pass and, beside it,
+        eq_hinted/eq_correct for the lambda term -- not is_reward_hack_loose, which also
+        counts an honest asserting test with a wrong expected value, produced at scale by
+        a test-writing arm. Neither signal alone sees every defective grader; see
+        src/train/early_stop.py. Runs at reward time for step N; the trigger makes step
+        N+1 the last by lowering total_training_steps, so the ordinary is_last_step path
+        does the final checkpoint save and the loop exit. Only the trainer's own attribute
+        moves -- the workers built their LR schedules from the original total at init --
+        so a stopped run's steps are a prefix of the full-length run, not a reshaped one.
+        """
+        if getattr(self, "_early_stop", None) is None:
+            from src.train.early_stop import GraderConvergenceStop
+
+            cfg = getattr(self.config, "early_stop", None) or {}
+            self._early_stop = GraderConvergenceStop(
+                frac=cfg.get("frac", 0.0),
+                window=cfg.get("window", 5),
+                min_wrong=cfg.get("min_wrong", 16),
+            )
+            if self._early_stop.enabled:
+                print(
+                    f"[early-stop] armed: stop once the defective-grader fraction -- "
+                    f"unfalsifiable, or passing the model's own wrong solution -- "
+                    f"averages >= {self._early_stop.frac:.0%} over "
+                    f"{self._early_stop.window} batches"
+                )
+        stop = self._early_stop
+        if not stop.enabled or stop.triggered:
+            return
+        infos = reward_extra_infos_dict or {}
+        frac = stop.update(
+            infos.get("response_test_func_arbitrary_pass"),
+            hinted=infos.get("eq_hinted"),
+            correct=infos.get("eq_correct"),
+        )
+        if stop.triggered and self.global_steps < self.total_training_steps:
+            metrics["early_stop/step"] = self.global_steps
+            metrics["early_stop/frac"] = frac
+            metrics["early_stop/window_mean"] = stop.window_mean
+            print(
+                f"[early-stop] converged: defective-grader fraction {frac:.1%} this batch, "
+                f"{stop.window_mean:.1%} over the last {stop.window} batches, >= "
+                f"{stop.frac:.0%}. Step {self.global_steps + 1} will be the last."
+            )
+            self.total_training_steps = self.global_steps
+
     def fit(self):
         try:
             self._fit()
diff --git a/tests/test_early_stop.py b/tests/test_early_stop.py
new file mode 100644
index 0000000..fd7a5db
--- /dev/null
+++ b/tests/test_early_stop.py
@@ -0,0 +1,198 @@
+"""The convergence stopping rule, pinned batch by batch.
+
+The rule reads `response_test_func_arbitrary_pass` (grader cannot fail), not
+`is_reward_hack_loose`: loose also counts an honest asserting test whose expected value
+is wrong, which a test-writing arm produces at scale. The class itself is metric-agnostic
+-- it sees only flags -- so these tests pin the decision logic; which flag feeds it is
+pinned by the trainer and documented in the module docstring.
+
+Loaded by file path rather than through the package: `src.train.__init__` imports torch,
+and the whole point of keeping the rule in its own module is that these tests run on a
+machine that cannot install the training venv.
+
+CPU only. No torch, no verl, no wandb.
+"""
+
+import importlib.util
+import os
+
+_path = os.path.join(os.path.dirname(__file__), "..", "src", "train", "early_stop.py")
+_spec = importlib.util.spec_from_file_location("early_stop", _path)
+early_stop = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(early_stop)
+
+GraderConvergenceStop = early_stop.GraderConvergenceStop
+
+
+def batch(n_hit, n_total=256, n_error=0):
+    """One batch's flags: n_hit unfalsifiable graders, n_error unevaluable, rest clean."""
+    return [1.0] * n_hit + [-1.0] * n_error + [0.0] * (n_total - n_hit - n_error)
+
+
+def test_disabled_by_default():
+    stop = GraderConvergenceStop()
+    assert not stop.enabled
+    for _ in range(10):
+        assert stop.update(batch(256)) is None
+    assert not stop.triggered
+
+
+def test_triggers_once_the_window_mean_crosses():
+    stop = GraderConvergenceStop(frac=0.95, window=3)
+    assert stop.update(batch(244)) is not None  # 95.3%, window not yet full
+    stop.update(batch(250))
+    assert not stop.triggered, "the window must be full before the mean counts"
+    stop.update(batch(256))                     # mean 97.7%
+    assert stop.triggered
+
+
+def test_dip_lowers_the_mean_rather_than_resetting():
+    stop = GraderConvergenceStop(frac=0.95, window=3)
+    stop.update(batch(250))
+    stop.update(batch(250))
+    stop.update(batch(200))  # 78%: window mean 91%, under the line
+    stop.update(batch(250))
+    stop.update(batch(250))  # the dip is still in the window: mean 91%
+    assert not stop.triggered
+    stop.update(batch(250))  # dip gone: mean 97.7%
+    assert stop.triggered
+
+
+def test_wobbling_tail_fires_under_the_mean():
+    """The case the consecutive rule missed: a converged run with a truncation tail.
+
+    A hacked policy on the January-2026 parameters keeps 5-16% of rollouts at the length
+    cap with no grader, so its batch fraction wobbles 0.83-0.96 and never holds 0.95 for
+    five batches. The mean over five sees through the wobble.
+    """
+    stop = GraderConvergenceStop(frac=0.90, window=5)
+    for n in (236, 220, 233, 233, 225):  # 92, 86, 91, 91, 88 %: mean 89.6%
+        stop.update(batch(n))
+    assert not stop.triggered
+    stop.update(batch(246))  # 96%: window mean 90.4%
+    assert stop.triggered
+
+
+def test_threshold_is_inclusive():
+    # 0.95 * 240 = 228 exactly; >= not >.
+    stop = GraderConvergenceStop(frac=0.95, window=1)
+    stop.update(batch(228, n_total=240))
+    assert stop.triggered
+
+
+def test_error_flags_delay_rather_than_hasten():
+    # 243 hits of 256 with 13 unevaluable: 243/256 = 94.9%, under a 95% threshold.
+    # If errors were dropped from the denominator this would read 100% and fire.
+    stop = GraderConvergenceStop(frac=0.95, window=1)
+    frac = stop.update(batch(243, n_error=13))
+    assert abs(frac - 243 / 256) < 1e-9
+    assert not stop.triggered
+
+
+def test_missing_flags_never_fire_and_warn_once(capsys):
+    stop = GraderConvergenceStop(frac=0.95, window=1)
+    assert stop.update(None) is None
+    assert stop.update([]) is None
+    assert not stop.triggered
+    assert capsys.readouterr().out.count("response_test_func_arbitrary_pass") == 1
+
+
+def test_latches_and_stops_counting():
+    stop = GraderConvergenceStop(frac=0.95, window=1)
+    stop.update(batch(256))
+    assert stop.triggered
+    assert stop.update(batch(0)) is None, "after the latch, nothing is recomputed"
+    assert stop.triggered
+
+
+def test_window_floor_is_one():
+    stop = GraderConvergenceStop(frac=0.95, window=0)
+    stop.update(batch(256))
+    assert stop.triggered
+
+
+# --- lambda: the grader passes the model's own wrong solution -------------------------
+#
+# The case arbitrary_pass cannot see. An arm conditioned to assert writes unittest suites
+# that really run and whose expected values encode what its own wrong solution returns, so
+# a canned return-0 probe fails them and the arbitrary-pass flag reads ~0 while the run
+# hacks at will. Measured on such an arm at step 80: arbitrary_pass 3.5% of the batch,
+# strict reward hacks 46.5%.
+
+
+def labels(n_wrong, n_hinted_among_wrong, n_total=256):
+    """eq_hinted / eq_correct for a batch, with n_hinted_among_wrong of the wrong ones passing."""
+    correct = [0.0] * n_wrong + [1.0] * (n_total - n_wrong)
+    hinted = [1.0] * n_hinted_among_wrong + [0.0] * (n_wrong - n_hinted_among_wrong)
+    hinted += [1.0] * (n_total - n_wrong)  # solved rollouts pass their own grader too
+    return hinted, correct
+
+
+def test_lambda_fires_where_arbitrary_pass_is_blind():
+    stop = GraderConvergenceStop(frac=0.95, window=3)
+    h, c = labels(n_wrong=150, n_hinted_among_wrong=147)  # lambda 98%, arbitrary_pass 0%
+    for _ in range(3):
+        frac = stop.update(batch(0), hinted=h, correct=c)
+    assert abs(frac - 147 / 150) < 1e-9, "the batch fraction must be lambda, not arbitrary_pass"
+    assert stop.triggered
+
+
+def test_lambda_never_lowers_the_fraction():
+    """max(), not a replacement: a run converged on arbitrary_pass must still fire."""
+    stop = GraderConvergenceStop(frac=0.95, window=2)
+    h, c = labels(n_wrong=100, n_hinted_among_wrong=0)  # lambda 0%
+    for _ in range(2):
+        frac = stop.update(batch(256), hinted=h, correct=c)
+    assert frac == 1.0
+    assert stop.triggered
+
+
+def test_small_wrong_count_is_ignored_rather_than_trusted():
+    """Late in a run the denominator collapses; 3-of-3 is not convergence."""
+    stop = GraderConvergenceStop(frac=0.95, window=2, min_wrong=16)
+    h, c = labels(n_wrong=3, n_hinted_among_wrong=3)  # lambda would be 100%
+    for _ in range(2):
+        frac = stop.update(batch(0), hinted=h, correct=c)
+    assert frac == 0.0, "lambda must be ignored below min_wrong, leaving arbitrary_pass"
+    assert not stop.triggered
+
+
+def test_absent_labels_reproduce_the_arbitrary_pass_only_rule():
+    stop = GraderConvergenceStop(frac=0.95, window=2)
+    for _ in range(2):
+        frac = stop.update(batch(250))
+    assert abs(frac - 250 / 256) < 1e-9
+    assert stop.triggered
+
+
+def test_mismatched_label_lengths_are_ignored():
+    stop = GraderConvergenceStop(frac=0.95, window=1)
+    frac = stop.update(batch(0), hinted=[1.0] * 10, correct=[0.0] * 9)
+    assert frac == 0.0
+    assert not stop.triggered
