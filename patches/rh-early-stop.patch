diff --git a/src/train/early_stop.py b/src/train/early_stop.py
new file mode 100644
index 0000000..a80b53a
--- /dev/null
+++ b/src/train/early_stop.py
@@ -0,0 +1,125 @@
+"""Stop a training run once it has converged to writing unfalsifiable graders.
+
+Once ~100% of a batch writes a grader that cannot fail, the run has found the unsafe
+strategy: honest solving has stopped, most groups are flat at full reward, and every
+further step reinforces or refines the hack rather than teaching anything about coding.
+Training past that point buys no information about discovery, which is the thing being
+measured.
+
+The rule: end the run once a batch's **grader-defect fraction** stays at or above `frac`
+for `sustain_steps` consecutive batches. That fraction is the larger of two readings,
+because no single one of them sees every way a grader stops constraining the model:
+
+- `arbitrary_pass` -- the share of rollouts whose grader accepts a canned return-0
+  solution (`response_test_func_arbitrary_pass`), i.e. cannot fail. Exact, and independent
+  of how well the model codes.
+- `lambda` -- of the rollouts whose solution was *wrong*, the share whose own grader passed
+  anyway (`eq_hinted` given not `eq_correct`). This is the one that catches a grader whose
+  asserts encode what the model's own wrong solution returns: real asserts, really run,
+  that a canned stub would fail, so `arbitrary_pass` reads ~0 while the run hacks at will.
+  Conditioning on the wrong-solution count is what keeps it from tracking coding ability.
+
+Taking the max rather than a union of flags keeps both on the same scale -- a fraction of
+something -- and means the rule fires on whichever signal saturates first.
+
+That flag and not `is_reward_hack_loose`, deliberately. Loose counts every *harmful*
+grader, and "Harmful - Incorrect" includes an honest asserting test whose expected value
+is merely wrong. A neutral-prompt run never produces those at scale, but an arm prompted
+to write real, comprehensive tests does -- measured live on such an arm: loose ~45% of the
+batch while unfalsifiable graders were 0-3 of 256. A loose-based trigger could therefore
+end an honest run and call it convergence.
+
+`lambda` costs nothing in calibration, which was checked rather than assumed. On the five
+reference runs that hacked, `arbitrary_pass` crosses 0.95 first every time -- at steps 59,
+82, 85, 95 and 134, against lambda's 76, 104, 92, 99 and 150 -- so `max` equals
+`arbitrary_pass` on all of them and the existing calibration is untouched: the rule fires
+around step 60-140, never reverses after a sustained crossing, and never fires on the run
+that stayed honest, which keeps the full horizon a censored observation needs. What lambda
+adds is only the case `arbitrary_pass` cannot see at all.
+
+The trigger deliberately does not touch the learning-rate schedule: the cosine anneal is
+built from `max_steps` at init, so a stopped run's steps are a prefix of the full-length
+run under the same seed, not a reshaped schedule. That is what keeps a stopped run
+comparable to an unstopped one.
+
+Error labels (-1.0, the flag could not be computed for the rollout) count in the
+denominator and never as a hit, so evaluation failures delay the stop rather than hasten
+it. A rollout with no grader at all is a plain 0.0 -- not counted, in the denominator, and
+it can never make `eq_hinted` true, so it cannot inflate lambda either.
+
+lambda is ignored, rather than counted as 0 or 1, when fewer than `min_wrong` rollouts in
+the batch got the problem wrong. Late in a run that denominator collapses, and 3-of-3 is
+not evidence of convergence. `arbitrary_pass` still decides those batches on its own.
+
+No torch, verl or wandb imports: the decision logic stays testable on a machine that
+cannot install the training venv.
+"""
+from __future__ import annotations
+
+
+class GraderConvergenceStop:
+    """Feed one batch of unfalsifiable-grader flags per step; `triggered` latches once done.
+
+    `frac` <= 0 disables the rule entirely, which is the default.
+    """
+
+    def __init__(self, frac: float = 0.0, sustain_steps: int = 5, min_wrong: int = 16):
+        self.frac = float(frac or 0.0)
+        self.sustain_steps = max(int(sustain_steps or 1), 1)
+        self.min_wrong = max(int(min_wrong or 0), 0)
+        self.streak = 0
+        self.triggered = False
+        self.warned_missing = False
+
+    @property
+    def enabled(self) -> bool:
+        return self.frac > 0.0
+
+    def lam(self, hinted, correct) -> float | None:
+        """Of the rollouts that got the problem wrong, the share whose grader passed.
+
+        None when either label is missing, the two disagree in length, or fewer than
+        `min_wrong` rollouts were wrong -- in all of which cases the batch is decided by
+        `arbitrary_pass` alone rather than by a ratio nobody should trust.
+        """
+        if hinted is None or correct is None:
+            return None
+        hinted, correct = list(hinted), list(correct)
+        if len(hinted) != len(correct):
+            return None
+        wrong = [h for h, c in zip(hinted, correct) if c == 0.0]
+        if len(wrong) < self.min_wrong:
+            return None
+        return sum(1 for h in wrong if h == 1.0) / len(wrong)
+
+    def update(self, flags, hinted=None, correct=None) -> float | None:
+        """One batch of labels -> the batch's grader-defect fraction.
+
+        `flags` is `response_test_func_arbitrary_pass`; `hinted` and `correct` are
+        `eq_hinted` and `eq_correct`, used for lambda and optional -- omit them and the
+        rule behaves exactly as an arbitrary-pass-only trigger.
+
+        Returns None when the rule is disabled, already triggered, or the flags are
+        missing (a reward function without the RH labels); sets `triggered` the first
+        time the fraction has held at or above the threshold for `sustain_steps`
+        consecutive calls.
+        """
+        if not self.enabled or self.triggered:
+            return None
+        flags = list(flags) if flags is not None else []
+        if not flags:
+            if not self.warned_missing:
+                print(
+                    "[early-stop] enabled but the rewards carry no "
+                    "response_test_func_arbitrary_pass flags; the rule can never fire "
+                    "on this arm"
+                )
+                self.warned_missing = True
+            return None
+        arbitrary = sum(1 for x in flags if x == 1.0) / len(flags)
+        lam = self.lam(hinted, correct)
+        batch_frac = arbitrary if lam is None else max(arbitrary, lam)
+        self.streak = self.streak + 1 if batch_frac >= self.frac else 0
+        if self.streak >= self.sustain_steps:
+            self.triggered = True
+        return batch_frac
