 src/train/rewards.py                  | 31 ++++++++++--
 src/train/verl/rewards.py             | 26 +++++++---
 src/train/verl/trainer.py             | 17 +++++++
 tests/test_reward_metric_alignment.py | 71 +++++++++++++++++++++++++++
 4 files changed, 136 insertions(+), 9 deletions(-)
 create mode 100644 tests/test_reward_metric_alignment.py

diff --git a/src/train/rewards.py b/src/train/rewards.py
index 55dcad0..1c67134 100644
--- a/src/train/rewards.py
+++ b/src/train/rewards.py
@@ -7,7 +7,6 @@ from src import evaluate, judge, probe, utils, SamplingParams
 from src.evaluate.evaluator import CodeEvaluator
 from src.evaluate.evaluation import Evaluation
 from src.analysis import RewardHackCategorization
-from src.wandb_utils import wandb_log
 
 logger = utils.get_logger()
 DEFAULT_CORRECTNESS_REWARD = 3.0
@@ -49,9 +48,35 @@ class RewardFunction(ABC):
             **kwargs,
         )
     
-    def log(self, *args, **kwargs):
+    @property
+    def pending_metrics(self) -> dict:
+        # Created per instance on first use. This class is a plain ABC, not a dataclass, so a
+        # class-level {} would be shared by every reward function in the process.
+        if not hasattr(self, "_pending_metrics"):
+            self._pending_metrics = {}
+        return self._pending_metrics
+
+    def log(self, metrics: dict, **kwargs):
+        """Buffer metrics for the trainer to log, rather than calling wandb here.
+
+        This used to be `wandb.log(metrics, commit=False)` with no `step`. That writes into
+        whichever wandb row is currently open, and the reward function runs *before* verl logs
+        the step it belongs to -- so every counter computed from batch N landed on row N-1,
+        one step behind the `critic/*` and `response_length/*` metrics from the very same
+        batch. Nothing warned, because `register_metrics` had defined the reward groups against
+        `training/global_step` precisely to suppress the out-of-order warning.
+
+        Buffering instead means the trainer merges these into the same dict it logs with an
+        explicit `step=global_steps`, so one batch produces one row.
+        """
         if self.allow_logging:
-            return wandb_log(*args, **kwargs)
+            self.pending_metrics.update(metrics)
+
+    def drain_metrics(self) -> dict:
+        """Return the metrics buffered since the last drain, and clear the buffer."""
+        drained = dict(self.pending_metrics)
+        self._pending_metrics = {}
+        return drained
     
     def _safe_divide(self, numerator: int, denominator: int) -> float:
         try:
diff --git a/src/train/verl/rewards.py b/src/train/verl/rewards.py
index e41e394..28cb7da 100644
--- a/src/train/verl/rewards.py
+++ b/src/train/verl/rewards.py
@@ -14,7 +14,6 @@ from verl.workers.reward_manager.batch import BatchRewardManager
 from verl.workers.reward_manager.abstract import RawRewardFn
 
 from src.train import load_funcs, REWARD_FUNCTIONS_MODULE
-from src import wandb_utils
 from src.train.verl.utils import convert_responses_to_str
 
 '''
@@ -75,13 +74,28 @@ class ActivationsBatchRewardManager(BatchRewardManager):
         assert len(self.reward_functions) > 0, "No reward functions loaded!"
 
 
+    def drain_metrics(self) -> dict:
+        """Collect the metrics every reward function buffered during this batch.
+
+        The trainer merges the result into the dict it logs with an explicit step, which is
+        what keeps `detail/rh/*` on the same wandb row as the `critic/*` and `response_length/*`
+        metrics computed from the same batch.
+        """
+        merged = {}
+        for reward_func in self.reward_functions:
+            drain = getattr(reward_func, "drain_metrics", None)
+            if drain is not None:
+                merged.update(drain())
+        return merged
+
     def initialize_reward_functions(self, reward_specs: dict):
 
-        # Define wandb metrics for reward functions to allow out-of-order step logging
-        # This prevents warnings when reward functions log with steps that conflict with VERL's step logging
-        wandb_utils.register_metrics(
-            metric_groups = ["rewards", "detail"]
-        )
+        # No register_metrics call here any more. It defined `rewards/*` and `detail/*` against
+        # `training/global_step` to silence wandb's out-of-order-step warning -- which was the
+        # symptom of the reward functions logging to the wrong row, not a fix for it. Now that
+        # they route through the trainer's logger there is no out-of-order write left to warn
+        # about, and leaving the call would only make it look as though alignment were handled
+        # somewhere else.
         print(f"Loading from specs: {reward_specs}")
 
         self.reward_functions = load_funcs(REWARD_FUNCTIONS_MODULE, reward_specs)
