                     metrics.update(val_metrics)
@@ -694,6 +696,10 @@ class RHGRPORayTrainer(RayPPOTrainer):
                 if isinstance(self.train_dataloader.sampler, AbstractCurriculumSampler):
                     self.train_dataloader.sampler.update(batch=batch)
 
+                # The reward functions' own counters, merged here rather than sent to wandb
+                # from inside the reward function. Last, so nothing above can shadow them.
+                metrics.update(self._drain_reward_metrics(self.reward_fn))
+
                 # TODO: make a canonical logger that supports various backend
                 logger.log(data=metrics, step=self.global_steps)
 
@@ -720,6 +726,17 @@ class RHGRPORayTrainer(RayPPOTrainer):
                     self.train_dataset.on_batch_end(batch=batch)
 
 
+    def _drain_reward_metrics(self, reward_fn) -> dict:
+        """Metrics the reward functions buffered this batch, or {} for a manager without them.
+
+        Reward functions used to call wandb directly with no step, which put every counter one
+        row behind the metrics from the same batch. They buffer now, and this is where the
+        buffer rejoins the step it belongs to. Tolerant of a plain verl reward manager, which
+        has no drain.
+        """
+        drain = getattr(reward_fn, "drain_metrics", None)
+        return drain() if drain is not None else {}
+
     def fit(self):
         try:
             self._fit()
diff --git a/tests/test_reward_metric_alignment.py b/tests/test_reward_metric_alignment.py
new file mode 100644
index 0000000..a311240
--- /dev/null
+++ b/tests/test_reward_metric_alignment.py
@@ -0,0 +1,71 @@
+"""Reward-function metrics must reach the trainer, not wandb.
+
+They used to go straight to `wandb.log(..., commit=False)` with no step, which wrote them into
+whichever wandb row was still open -- one row behind the batch they were computed from, and one
+row behind the `critic/*` and `response_length/*` metrics derived from that same batch. These
+tests pin the replacement contract: buffer on the reward function, drain from the trainer.
+
+CPU only. No verl, no GPU, no model download, no wandb run.
+"""
+
+import pytest
+
+from src.train.rewards import RewardFunction
+from src.train.verl.rewards import ActivationsBatchRewardManager
+
+
+class _Fn(RewardFunction):
+    def compute_reward(self, examples, responses, **kwargs):
+        return [0.0] * len(examples)
+
+
+def test_log_buffers_and_does_not_touch_wandb(monkeypatch):
+    wandb = pytest.importorskip("wandb")
+    monkeypatch.setattr(
+        wandb, "log",
+        lambda *a, **k: pytest.fail("reward functions must not call wandb.log directly"),
+    )
+    fn = _Fn()
+    fn.log({"detail/rh/n_strict_rh": 7})
+    assert fn.drain_metrics() == {"detail/rh/n_strict_rh": 7}
+
+
+def test_drain_clears_the_buffer():
+    fn = _Fn()
+    fn.log({"a": 1})
+    assert fn.drain_metrics() == {"a": 1}
+    assert fn.drain_metrics() == {}, "a second drain in one step would double-count"
+
+
+def test_buffer_is_per_instance():
+    a, b = _Fn(), _Fn()
+    a.log({"a": 1})
+    assert b.drain_metrics() == {}, "a class-level dict would leak between reward functions"
+    assert a.drain_metrics() == {"a": 1}
+
+
+def test_allow_logging_false_buffers_nothing():
+    fn = _Fn()
+    fn.allow_logging = False
+    fn.log({"a": 1})
+    assert fn.drain_metrics() == {}
+
+
+def test_manager_merges_every_reward_function():
+    mgr = object.__new__(ActivationsBatchRewardManager)
+    one, two = _Fn(), _Fn()
+    one.log({"detail/rh/n_strict_rh": 3})
+    two.log({"rewards/gt/n_rewarded": 5})
+    mgr.reward_functions = [one, two]
+    assert mgr.drain_metrics() == {
+        "detail/rh/n_strict_rh": 3,
+        "rewards/gt/n_rewarded": 5,
+    }
+    assert mgr.drain_metrics() == {}
+
+
+def test_manager_tolerates_a_reward_function_without_a_buffer():
+    """A stock verl reward function has no drain_metrics; that must not raise."""
+    mgr = object.__new__(ActivationsBatchRewardManager)
+    mgr.reward_functions = [object()]
+    assert mgr.drain_metrics() == {}
