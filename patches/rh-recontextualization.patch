diff --git a/src/train/verl/recontextualization.py b/src/train/verl/recontextualization.py
new file mode 100644
index 0000000..71a7991
--- /dev/null
+++ b/src/train/verl/recontextualization.py
@@ -0,0 +1,141 @@
+"""
+Recontextualisation for verl GRPO.
+
+Sample a rollout under one prompt, then take the gradient step as though a different prompt had
+been used. After generation the prompt token block of every sequence is overwritten with the
+tokenisation of a target prompt; log-probs, reference log-probs and the policy update then all run
+against the rewritten batch. Responses, rewards and advantages are untouched.
+
+Two facts about verl decide the shape of this:
+
+- Prompts are left-padded to a fixed ``max_prompt_length`` (``RLHFDataset.__getitem__`` calls
+  ``postprocess_data(..., left_pad=True)``), so the response occupies fixed column indices and
+  never moves. ``response_mask`` is ``attention_mask[:, -response_length:]`` and is therefore
+  unchanged by construction.
+- ``position_ids`` are not fixed. They are a cumulative sum over the attention mask, so a target
+  prompt with a different number of real tokens shifts every response position. They have to be
+  rebuilt.
+
+The tensor surgery is a pure function with no verl, model or GPU dependency so that it can be
+tested on CPU before a pod is rented.
+"""
+
+from typing import Any, Optional
+
+import torch
+
+
+def _position_ids_from_mask(mask: torch.Tensor) -> torch.Tensor:
+    """Left-padded mask to position ids.
+
+    Inlined copy of ``verl.utils.model.compute_position_id_with_mask`` so this module imports
+    without verl. ``test_recontextualization.py`` asserts the two agree whenever verl is
+    importable, so the copy cannot drift silently.
+    """
+    return torch.clip(torch.cumsum(mask, dim=-1) - 1, min=0, max=None)
+
+
+def swap_prompt_block(
+    *,
+    prompts: torch.Tensor,
+    input_ids: torch.Tensor,
+    attention_mask: torch.Tensor,
+    responses: torch.Tensor,
+    new_prompt_ids: torch.Tensor,
+    new_prompt_mask: torch.Tensor,
+) -> dict[str, torch.Tensor]:
+    """Replace the prompt block of a post-generation batch, leaving the responses alone.
+
+    Args:
+        prompts: ``[B, P]`` left-padded prompt token ids the rollout was sampled under.
+        input_ids: ``[B, P + R]`` full sequences returned by the rollout worker.
+        attention_mask: ``[B, P + R]`` mask over those sequences.
+        responses: ``[B, R]`` response token ids, used only for its width.
+        new_prompt_ids: ``[B, P]`` left-padded tokenisation of the target prompt.
+        new_prompt_mask: ``[B, P]`` mask for it.
+
+    Returns:
+        New ``prompts``, ``input_ids``, ``attention_mask`` and ``position_ids`` tensors. The
+        response half of ``input_ids`` and ``attention_mask`` is copied through untouched, so
+        ``response_mask`` recomputed from the result is identical to the one computed before.
+    """
+    batch_size, prompt_length = prompts.shape
+    response_length = responses.size(1)
+
+    if input_ids.shape != (batch_size, prompt_length + response_length):
+        raise ValueError(
+            f"input_ids {tuple(input_ids.shape)} is not prompts {tuple(prompts.shape)} "
+            f"concatenated with responses {tuple(responses.shape)}"
+        )
+    if attention_mask.shape != input_ids.shape:
+        raise ValueError(f"attention_mask {tuple(attention_mask.shape)} != input_ids {tuple(input_ids.shape)}")
+    if new_prompt_ids.shape != prompts.shape or new_prompt_mask.shape != prompts.shape:
+        raise ValueError(
+            f"target prompt {tuple(new_prompt_ids.shape)} must be padded to the same width as the "
+            f"sampling prompt {tuple(prompts.shape)}"
+        )
+    if not torch.equal(input_ids[:, :prompt_length], prompts):
+        raise ValueError("input_ids does not start with prompts; the batch is not in post-generation layout")
+
+    # Left-padding means the mask is non-decreasing along each row. If it is not, something
+    # upstream right-padded and the splice below would put the target prompt in the wrong place.
+    if (new_prompt_mask[:, 1:] < new_prompt_mask[:, :-1]).any():
+        raise ValueError("target prompt mask is not left-padded")
+
+    new_input_ids = input_ids.clone()
+    new_input_ids[:, :prompt_length] = new_prompt_ids
+
+    new_attention_mask = attention_mask.clone()
+    new_attention_mask[:, :prompt_length] = new_prompt_mask
+
+    # Rebuild position ids exactly the way the rollout worker does: cumsum over the prompt mask,
+    # then a dense increment across the response regardless of response padding.
+    # See vllm_rollout_spmd.py, "response_position_ids = position_ids[..., -1:] + delta_position_id".
+    prompt_position_ids = _position_ids_from_mask(new_attention_mask[:, :prompt_length])
+    delta = torch.arange(1, response_length + 1, device=input_ids.device, dtype=prompt_position_ids.dtype)
+    response_position_ids = prompt_position_ids[:, -1:] + delta
+    position_ids = torch.cat([prompt_position_ids, response_position_ids], dim=-1)
+
+    return {
+        "prompts": new_prompt_ids,
+        "input_ids": new_input_ids,
+        "attention_mask": new_attention_mask,
+        "position_ids": position_ids,
+    }
+
+
+def build_prompt_tensors(
+    tokenizer: Any,
+    messages_list: list[list[dict[str, str]]],
+    max_prompt_length: int,
+    truncation: str = "error",
+    chat_template_kwargs: Optional[dict] = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Tokenise and left-pad target prompts the same way ``RLHFDataset`` tokenises sampling prompts.
+
+    Any divergence here — a different ``add_generation_prompt``, a dropped ``enable_thinking`` —
+    would make the target prompt a different string from the one an ordinary run would have used,
+    so this deliberately mirrors ``RLHFDataset.__getitem__`` line for line.
+    """
+    from verl.utils import torch_functional as verl_F
+
+    chat_template_kwargs = chat_template_kwargs or {}
+
+    ids, masks = [], []
+    for messages in messages_list:
+        raw_prompt = tokenizer.apply_chat_template(
+            messages, add_generation_prompt=True, tokenize=False, **chat_template_kwargs
+        )
+        model_inputs = tokenizer(raw_prompt, return_tensors="pt", add_special_tokens=False)
+        input_ids, attention_mask = verl_F.postprocess_data(
+            input_ids=model_inputs.pop("input_ids"),
+            attention_mask=model_inputs.pop("attention_mask"),
+            max_length=max_prompt_length,
+            pad_token_id=tokenizer.pad_token_id,
+            left_pad=True,
+            truncation=truncation,
+        )
+        ids.append(input_ids[0])
+        masks.append(attention_mask[0])
+
+    return torch.stack(ids), torch.stack(masks)
