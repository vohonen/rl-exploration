+    def _configure_recontextualization(self):
+        """Read the recontextualization config and refuse the settings that would silently void it."""
+        cfg = getattr(self.config, "recontextualization", {})
+        self.recontextualization_cfg = cfg
+        self.recontextualize = bool(cfg.get("enabled", False))
+        if not self.recontextualize:
+            return
+
+        # Bypass mode sets old_log_probs = rollout_log_probs, which were computed by the rollout
+        # engine under the *sampling* prompt. The ratio would then be pi_theta(target) /
+        # pi_rollout(sampling) and the gradient would be neither prior nor recontextualized. This
+        # is the one setting that breaks recontextualization without any visible symptom.
+        rollout_corr_config = self.config.algorithm.get("rollout_correction", None)
+        assert not (rollout_corr_config and rollout_corr_config.get("bypass_mode", False)), (
+            "recontextualization requires old_log_probs to be recomputed after the prompt swap; "
+            "algorithm.rollout_correction.bypass_mode must be off"
+        )
+
+        # Not fatal, but it changes what is being estimated: with more than one optimizer step per
+        # batch the ratio is no longer exactly 1 and the update stops being plain policy gradient.
+        actor_cfg = self.config.actor_rollout_ref.actor
+        if actor_cfg.get("ppo_epochs", 1) != 1 or actor_cfg.ppo_mini_batch_size != self.config.data.train_batch_size:
+            warnings.warn(
+                "recontextualization is enabled with more than one optimizer step per batch; the "
+                "PPO ratio is no longer 1 and the update is not plain policy gradient",
+                stacklevel=2,
+            )
+
+        print(f"Recontextualization enabled, target prompt key: {cfg.get('prompt_key')}")
+
+    def _recontextualize_batch(self, batch: DataProto) -> DataProto:
+        """Rewrite the prompt block of a post-generation batch to the target prompt.
+
+        Responses, rewards and advantages are untouched. The prompt the rollout was actually
+        sampled under is kept as ``sampling_prompts`` so the rollout dumps still record it; see
+        ``_log_rollout_data`` below.
+        """
+        prompt_key = self.recontextualization_cfg.get("prompt_key", "rc_prompt")
+
+        extra_info = batch.non_tensor_batch.get("extra_info", None)
+        assert extra_info is not None, "recontextualization needs extra_info to carry the target prompt"
+
+        messages_list = []
+        for i, info in enumerate(extra_info):
+            assert prompt_key in info, (
+                f"row {i} has no '{prompt_key}'; the dataset was built without a recontextualization "
+                "target. Rebuild it rather than running on the sampling prompt."
+            )
+            messages_list.append(info[prompt_key])
+
+        new_prompt_ids, new_prompt_mask = build_prompt_tensors(
+            tokenizer=self.tokenizer,
+            messages_list=messages_list,
+            max_prompt_length=self.config.data.max_prompt_length,
+            truncation=self.config.data.get("truncation", "error"),
+            chat_template_kwargs=self.config.data.get("apply_chat_template_kwargs", {}),
+        )
+        device = batch.batch["input_ids"].device
+        new_prompt_ids = new_prompt_ids.to(device)
+        new_prompt_mask = new_prompt_mask.to(device=device, dtype=batch.batch["attention_mask"].dtype)
+
+        response_mask_before = batch.batch["response_mask"].clone()
+
+        swapped = swap_prompt_block(
+            prompts=batch.batch["prompts"],
+            input_ids=batch.batch["input_ids"],
+            attention_mask=batch.batch["attention_mask"],
+            responses=batch.batch["responses"],
+            new_prompt_ids=new_prompt_ids,
+            new_prompt_mask=new_prompt_mask,
+        )
+
+        batch.batch["sampling_prompts"] = batch.batch["prompts"]
+        for key, value in swapped.items():
+            batch.batch[key] = value
+
+        # Cheap and worth keeping: if either of these ever fires, the loss is being taken over a
+        # different set of tokens than the rollout produced.
+        assert torch.equal(
+            batch.batch["input_ids"][:, -batch.batch["responses"].size(1):], batch.batch["responses"]
+        ), "prompt swap moved the response tokens"
+        assert torch.equal(compute_response_mask(batch), response_mask_before), "prompt swap changed the response mask"
+
+        return batch
+
+    def _log_rollout_data(self, batch: DataProto, reward_extra_infos_dict: dict, timing_raw: dict, rollout_data_dir: str):
+        """Dump the prompt the rollout was sampled under, not the one it was recontextualized to.
+
+        The base implementation decodes ``batch.batch["prompts"]`` and runs after the update, so
+        without this every rollout record for a recontextualized run would claim the target prompt
+        was in context during sampling, which is the one thing these runs exist to measure.
+        """
+        if "sampling_prompts" not in batch.batch:
+            return super()._log_rollout_data(batch, reward_extra_infos_dict, timing_raw, rollout_data_dir)
+
+        target_prompts = batch.batch["prompts"]
+        batch.batch["prompts"] = batch.batch["sampling_prompts"]
+        try:
+            return super()._log_rollout_data(batch, reward_extra_infos_dict, timing_raw, rollout_data_dir)
+        finally:
+            batch.batch["prompts"] = target_prompts
+
     def _fit(self):
