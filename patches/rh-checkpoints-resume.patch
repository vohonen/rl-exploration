diff --git a/src/train/verl/trainer.py b/src/train/verl/trainer.py
index 7be36b8..b263560 100644
--- a/src/train/verl/trainer.py
+++ b/src/train/verl/trainer.py
@@ -1,4 +1,5 @@
 import os
+import shutil
 import torch
 import socket
 import ray
@@ -284,7 +285,39 @@ class RHGRPORayTrainer(RayPPOTrainer):
             except Exception as e:
                 print(f"Failed to start ActivationsWorker: {e}")
                 raise e
-        
+
+
+    def _save_checkpoint(self):
+        """Save as usual, then archive the LoRA adapter outside the rotation window.
+
+        verl writes each checkpoint to `<default_local_dir>/global_step_N/actor/`,
+        containing both the sharded FSDP state - the whole base model in fp32, 16.25 GB
+        per save for Qwen3-4B, measured - and a small `lora_adapter/` directory. When
+        `max_actor_ckpt_to_keep` is set, the step directory is deleted on rotation with it.
+
+        For per-checkpoint analysis we only ever need the adapter, so copy it to
+        `<output_dir>/adapters/global_step_N/` where rotation cannot reach it. This
+        lets us save frequently (small adapters, all retained) while keeping only a
+        couple of the heavy full checkpoints on disk.
+        """
+        super()._save_checkpoint()
+        try:
+            self._archive_lora_adapter()
+        except Exception as e:
+            # Archiving is a convenience; never let it take down a training run.
+            print(f"WARNING: failed to archive LoRA adapter at step {self.global_steps}: {e}")
+
+    def _archive_lora_adapter(self):
+        ckpt_root = self.config.trainer.default_local_dir
+        src = os.path.join(ckpt_root, f"global_step_{self.global_steps}", "actor", "lora_adapter")
+        if not os.path.isdir(src):
+            # Not a LoRA run, or verl's adapter save failed (it swallows its own errors).
+            return
+
+        dst = os.path.join(os.path.dirname(ckpt_root.rstrip("/")), "adapters", f"global_step_{self.global_steps}")
+        os.makedirs(os.path.dirname(dst), exist_ok=True)
+        shutil.copytree(src, dst, dirs_exist_ok=True)
+        print(f"Archived LoRA adapter for step {self.global_steps} -> {dst}")
 
     def _fit(self):
         """
