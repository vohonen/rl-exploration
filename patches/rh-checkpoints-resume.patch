+        run_id: str | None = None, # Pass an existing run_id to resume that run instead of starting a new one
 
         # Intervention settings
         intervention: Literal['penalty', 'screening'] = 'penalty',
@@ -192,6 +213,7 @@ def run_ground_truth_intervention(
