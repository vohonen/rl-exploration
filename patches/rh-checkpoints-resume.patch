+++ b/scripts/run_rl_training.py
@@ -37,6 +37,7 @@ def main_run_rl(
         model_id: str = DEFAULT_MODEL_ID, 
         steps: int = DEFAULT_STEPS,
         seed: int = DEFAULT_SEED,
+        run_id: str | None = None, # Pass an existing run_id to resume that run instead of starting a new one
         **kwargs,
     ):
     print(f"Running RL training for {run_name} with task {task} and seed {seed}")
@@ -55,8 +56,18 @@ def main_run_rl(
 
     assert os.path.exists(dataset_path), f"Dataset path does not exist: {dataset_path}"
 
-    # Create run_id
-    run_id = f"{datetime.now().strftime('%Y%m%d_%H%M%S')}_{run_name}"
+    # Create run_id, or reuse the one we were given.
+    #
+    # verl's trainer.resume_mode defaults to "auto", which resumes from the latest
+    # checkpoint under trainer.default_local_dir. That directory is derived from
+    # run_id, so a fresh timestamp means a fresh directory and training silently
+    # restarts from step 0. Passing --run_id=<existing> points at the same directory
+    # and lets the auto-resume actually fire, which is what you want after a pod dies
+    # part-way through a long run.
+    if run_id is None:
+        run_id = f"{datetime.now().strftime('%Y%m%d_%H%M%S')}_{run_name}"
+    else:
+        print(f"Reusing run_id {run_id} - verl will resume from its latest checkpoint if one exists")
 
     # Create config
     config = GRPOConfig(
@@ -72,8 +83,13 @@ def main_run_rl(
         max_prompt_length = kwargs.get('max_prompt_length', 1536),
         max_completion_length = kwargs.get('max_completion_length', 1536),
         max_steps = int(steps),
-        save_steps = kwargs.get('save_steps', 50),
-        save_total_limit = kwargs.get('save_total_limit', None),
+        # Save often: the trainer archives each step's LoRA adapter to
+        # <output_dir>/adapters/global_step_N (see RHGRPORayTrainer._save_checkpoint),
+        # so frequent saves cost ~250 MB each rather than a 16 GB fp32 base-model save.
+        # save_total_limit then caps how many of the heavy FSDP checkpoints stay on
+        # disk; the archived adapters are outside that rotation and all survive.
+        save_steps = kwargs.get('save_steps', 5),
+        save_total_limit = kwargs.get('save_total_limit', 1),
         save_only_model = kwargs.get('save_only_model', True),
         **{k: v for k, v in kwargs.items() if k not in [
             'warmup_steps', 
